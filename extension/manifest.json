{
  "manifest_version": 3,
  "name": "Ducky — Volume Booster",
  "short_name": "Ducky",
  "version": "3.5",
  "description": "Boost any video or tab up to 600%, with a distortion limiter, bass boost and per-site memory.",
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "engine.js"
      ],
      "world": "MAIN",
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ducky",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "volume-up": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "Volume up 25%"
    },
    "volume-down": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "Volume down 25%"
    },
    "volume-reset": {
      "suggested_key": {
        "default": "Alt+Shift+0"
      },
      "description": "Reset to 100%"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "minimum_chrome_version": "119",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
